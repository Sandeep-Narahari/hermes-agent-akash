#!/command/with-contenv sh
# shellcheck shell=sh
# ttyd web terminal. Enabled with WEB_TERMINAL_ENABLED=true; otherwise exits
# and ./finish marks the slot permanently down (same pattern as upstream's
# dashboard service).
case "${WEB_TERMINAL_ENABLED:-}" in
    1|true|TRUE|True|yes|YES|Yes) ;;
    *) exit 0 ;;
esac

port="${WEB_TERMINAL_PORT:-7681}"
user="${WEB_TERMINAL_USER:-hermes}"
password="${WEB_TERMINAL_PASSWORD:-}"
if [ -z "$password" ]; then
    password="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 20)"
    echo "================================================================"
    echo "  Web terminal login: user / ${password}   (auto-generated)"
    echo "  Set WEB_TERMINAL_PASSWORD to use a fixed password."
    echo "================================================================"
fi

export TERM=xterm-256color COLORTERM=truecolor
export HOME=/opt/data
cd "${HERMES_HOME:-/opt/data/data_dir}"

echo "[web-terminal] Starting ttyd on port ${port} (shell user: ${user})"
# -d 3: errors/warnings only (default notices print the credential).
set -- ttyd -d 3 --port "$port" --writable -t rendererType=canvas \
    --credential "user:${password}" /bin/bash -l
if [ "$user" = "root" ]; then
    exec "$@"
fi
exec /command/s6-setuidgid hermes "$@"
