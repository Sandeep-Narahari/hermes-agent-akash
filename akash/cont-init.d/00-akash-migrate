#!/command/with-contenv sh
# shellcheck shell=sh
# Akash pre-setup. Runs as root BEFORE upstream's 01-hermes-setup (stage2).
#
#  1. Optional bulk import of an older Hermes home (HERMES_MIGRATION_URL /
#     HERMES_MIGRATION_DIR) into an uninitialized $HERMES_HOME.
#  2. One-time ownership fix for volumes created by the pre-v0.23 image of
#     this repo, which ran everything as root. Upstream now drops to the
#     `hermes` user (UID 10000) and only chowns a targeted list of subdirs,
#     so root-owned state DBs / config would be unwritable.
#  3. Notice about the dead code copy the old image left on the volume.
set -u

HERMES_HOME="${HERMES_HOME:-/opt/data/data_dir}"
DATA_ROOT="/opt/data"
OWNERSHIP_MARKER="${DATA_ROOT}/.akash_ownership_v1"

log() { echo "[akash] $*"; }

mkdir -p "$HERMES_HOME"

# ── 1. Optional bulk migration ──────────────────────────────────────────────
if [ ! -f "$HERMES_HOME/config.yaml" ]; then
    if [ -n "${HERMES_MIGRATION_URL:-}" ]; then
        log "HERMES_MIGRATION_URL set — downloading migration archive..."
        tmp="$(mktemp /tmp/hermes-migration.XXXXXX)"
        if curl -fsSL --retry 3 -o "$tmp" "$HERMES_MIGRATION_URL"; then
            log "Extracting archive into $HERMES_HOME..."
            tar -xzf "$tmp" -C "$HERMES_HOME" --strip-components=1 || \
                log "Warning: failed to extract migration archive"
        else
            log "Warning: failed to download migration archive"
        fi
        rm -f "$tmp"
    elif [ -n "${HERMES_MIGRATION_DIR:-}" ] && [ -d "$HERMES_MIGRATION_DIR" ]; then
        log "Copying $HERMES_MIGRATION_DIR into $HERMES_HOME..."
        cp -pnR "$HERMES_MIGRATION_DIR/." "$HERMES_HOME/" || true
    fi
fi

# ── 2. One-time ownership fix ───────────────────────────────────────────────
# Safe to recurse: /opt/data is the deployment's own persistent volume.
if [ ! -f "$OWNERSHIP_MARKER" ]; then
    log "Fixing ownership of $HERMES_HOME for the hermes runtime user (one-time)..."
    chown -R hermes:hermes "$HERMES_HOME" 2>/dev/null || \
        log "Warning: chown of $HERMES_HOME failed — continuing"
    # HOME is /opt/data for the runtime user (~/.config, ~/.local, ...).
    chown hermes:hermes "$DATA_ROOT" 2>/dev/null || true
    for d in .config .local .cache .npm; do
        [ -e "$DATA_ROOT/$d" ] && chown -R hermes:hermes "$DATA_ROOT/$d" 2>/dev/null || true
    done
    touch "$OWNERSHIP_MARKER"
fi

# ── 3. Legacy code copy left by the old image ───────────────────────────────
if [ -d "$DATA_ROOT/hermes" ] && [ -d "$DATA_ROOT/hermes/.venv" ]; then
    case "${AKASH_PRUNE_LEGACY:-}" in
        1|true|TRUE|True|yes|YES|Yes)
            log "AKASH_PRUNE_LEGACY set — removing old code copy at $DATA_ROOT/hermes"
            rm -rf "$DATA_ROOT/hermes" "$DATA_ROOT/.setup_complete_v2"
            ;;
        *)
            log "Notice: $DATA_ROOT/hermes is an unused code copy from the old image."
            log "        Set AKASH_PRUNE_LEGACY=true once to free that volume space."
            ;;
    esac
fi

exit 0
